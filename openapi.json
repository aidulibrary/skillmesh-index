{
  "openapi": "3.0.3",
  "info": {
    "title": "SkillMesh CCP — 能力通约协议 API",
    "description": "SkillMesh / 插台 的能力通约协议（Capability Commensurability Protocol）API。\n\nCCP 提供跨平台、跨框架的能力锚点发现、搜索、适配与联邦化能力。所有端点返回 `X-CCP-Version: v1.0.0` 头。",
    "version": "v1.0.0",
    "contact": {
      "name": "SkillMesh Community",
      "url": "https://skillmesh.礼字号.中国"
    },
    "license": {
      "name": "MIT",
      "url": "https://opensource.org/licenses/MIT"
    }
  },
  "servers": [
    {
      "url": "https://skillmesh.礼字号.中国/api/ccp/v1",
      "description": "Production"
    },
    {
      "url": "https://skillmesh.pages.dev/api/ccp/v1",
      "description": "Cloudflare Pages"
    }
  ],
  "tags": [
    { "name": "Capabilities", "description": "能力锚点发现与查询" },
    { "name": "Search", "description": "全文搜索与语义搜索" },
    { "name": "Adapters", "description": "框架适配器生成" },
    { "name": "Federation", "description": "联邦节点管理与交换" },
    { "name": "Telemetry", "description": "遥测与社区贡献" },
    { "name": "Governance", "description": "治理与贡献者" },
    { "name": "System", "description": "监控、健康检查、统计" }
  ],
  "paths": {
    "/capabilities": {
      "get": {
        "tags": ["Capabilities"],
        "summary": "能力锚点列表",
        "description": "返回全部已注册的能力锚点列表。支持通过查询参数过滤。",
        "parameters": [
          {
            "name": "q",
            "in": "query",
            "description": "关键词过滤（名称/描述）",
            "schema": { "type": "string" }
          },
          {
            "name": "category",
            "in": "query",
            "description": "分类过滤（支持中文/英文/日文别名：ai、data、media、language、dev）",
            "schema": { "type": "string" }
          }
        ],
        "responses": {
          "200": {
            "description": "能力列表",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "protocol": { "type": "string", "example": "CCP" },
                    "version": { "type": "string", "example": "v1.0.0" },
                    "capabilities": {
                      "type": "array",
                      "items": { "$ref": "#/components/schemas/Capability" }
                    },
                    "count": { "type": "integer" }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/capabilities/{id}": {
      "get": {
        "tags": ["Capabilities"],
        "summary": "能力锚点详情",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "description": "能力锚点 ID（如 pdf-extract-text-001）",
            "schema": { "type": "string" }
          }
        ],
        "responses": {
          "200": {
            "description": "能力详情",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "protocol": { "type": "string" },
                    "version": { "type": "string" },
                    "capability": { "$ref": "#/components/schemas/Capability" }
                  }
                }
              }
            }
          },
          "404": {
            "description": "能力不存在",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/Error" }
              }
            }
          }
        }
      }
    },
    "/capabilities/{id}/versions": {
      "get": {
        "tags": ["Capabilities"],
        "summary": "能力版本历史",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": { "type": "string" }
          }
        ],
        "responses": {
          "200": {
            "description": "版本列表",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "protocol": { "type": "string" },
                    "version": { "type": "string" },
                    "capability_id": { "type": "string" },
                    "versions": {
                      "type": "array",
                      "items": { "type": "object" }
                    },
                    "count": { "type": "integer" }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/capabilities/{id}/adapters/{framework}": {
      "get": {
        "tags": ["Adapters"],
        "summary": "框架适配器",
        "description": "为目标框架生成适配器配置。支持 dsh、mcp、langchain、crewai、dify。",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": { "type": "string" }
          },
          {
            "name": "framework",
            "in": "path",
            "required": true,
            "description": "目标框架",
            "schema": {
              "type": "string",
              "enum": ["dsh", "mcp", "langchain", "crewai", "dify"]
            }
          }
        ],
        "responses": {
          "200": {
            "description": "适配器配置（格式因框架而异）",
            "content": {
              "application/json": {
                "schema": { "type": "object" }
              },
              "text/yaml": {
                "schema": { "type": "string" }
              }
            }
          },
          "404": {
            "description": "能力或框架不支持",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/Error" }
              }
            }
          }
        }
      }
    },
    "/search": {
      "get": {
        "tags": ["Search"],
        "summary": "搜索能力",
        "description": "全文搜索 + 语义搜索。当 Workers AI 可用时，自动附加语义匹配增强。",
        "parameters": [
          {
            "name": "q",
            "in": "query",
            "required": true,
            "description": "搜索关键词或自然语言描述句",
            "schema": { "type": "string" }
          },
          {
            "name": "federated",
            "in": "query",
            "description": "是否跨联邦节点搜索",
            "schema": { "type": "boolean", "default": false }
          }
        ],
        "responses": {
          "200": {
            "description": "搜索结果",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "query": { "type": "string" },
                    "results": {
                      "type": "array",
                      "items": { "$ref": "#/components/schemas/Capability" }
                    },
                    "count": { "type": "integer" },
                    "semantic": { "type": "boolean" }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/federation": {
      "get": {
        "tags": ["Federation"],
        "summary": "本节点信息",
        "responses": {
          "200": {
            "description": "节点信息",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/FederationNode" }
              }
            }
          }
        }
      }
    },
    "/federation/nodes": {
      "get": {
        "tags": ["Federation"],
        "summary": "联邦节点列表",
        "responses": {
          "200": {
            "description": "节点列表",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "nodes": {
                      "type": "array",
                      "items": { "$ref": "#/components/schemas/FederationNode" }
                    },
                    "count": { "type": "integer" }
                  }
                }
              }
            }
          }
        }
      },
      "post": {
        "tags": ["Federation"],
        "summary": "注册联邦节点",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["id", "name", "endpoint"],
                "properties": {
                  "id": { "type": "string" },
                  "name": { "type": "string" },
                  "endpoint": { "type": "string", "format": "uri" },
                  "description": { "type": "string" },
                  "trust_weight": { "type": "number", "default": 0.5 }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "注册成功",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "accepted": { "type": "boolean" },
                    "node": { "$ref": "#/components/schemas/FederationNode" }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/federation/nodes/{id}": {
      "delete": {
        "tags": ["Federation"],
        "summary": "移除联邦节点",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": { "type": "string" }
          }
        ],
        "responses": {
          "200": {
            "description": "移除成功",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "deleted": { "type": "boolean" },
                    "node_id": { "type": "string" }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/federation/nodes/{id}/trust-policy": {
      "put": {
        "tags": ["Federation"],
        "summary": "更新节点信任策略",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": { "type": "string" }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "trust_weight": { "type": "number" },
                  "status": {
                    "type": "string",
                    "enum": ["active", "inactive", "suspended"]
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": { "description": "更新成功" }
        }
      }
    },
    "/federation/exchange": {
      "post": {
        "tags": ["Federation"],
        "summary": "索引摘要交换",
        "description": "与联邦节点交换能力索引摘要，用于联邦搜索。",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "node_id": { "type": "string" },
                  "node_name": { "type": "string" },
                  "capabilities_count": { "type": "integer" },
                  "hash": { "type": "string" }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "交换结果",
            "content": {
              "application/json": {
                "schema": { "type": "object" }
              }
            }
          }
        }
      }
    },
    "/telemetry": {
      "post": {
        "tags": ["Telemetry"],
        "summary": "遥测回传",
        "description": "客户端上报调用遥测数据（最佳努力，失败静默）。",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "agent_id": { "type": "string" },
                  "capability_id": { "type": "string" },
                  "success": { "type": "boolean" },
                  "latency_ms": { "type": "integer" },
                  "error_type": { "type": "string" }
                }
              }
            }
          }
        },
        "responses": {
          "202": { "description": "已接受" }
        }
      }
    },
    "/contribute": {
      "post": {
        "tags": ["Telemetry"],
        "summary": "社区贡献",
        "description": "提交新的能力锚点定义。",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": { "type": "object" }
            }
          }
        },
        "responses": {
          "202": { "description": "已提交审核" }
        }
      }
    },
    "/contributors": {
      "get": {
        "tags": ["Governance"],
        "summary": "贡献者列表",
        "responses": {
          "200": {
            "description": "贡献者数据",
            "content": {
              "application/json": {
                "schema": { "type": "object" }
              }
            }
          }
        }
      }
    },
    "/governance": {
      "get": {
        "tags": ["Governance"],
        "summary": "治理提案列表",
        "responses": {
          "200": { "description": "提案列表" }
        }
      },
      "post": {
        "tags": ["Governance"],
        "summary": "创建治理提案",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": { "type": "object" }
            }
          }
        },
        "responses": {
          "201": { "description": "创建成功" }
        }
      },
      "patch": {
        "tags": ["Governance"],
        "summary": "投票或更新提案",
        "responses": {
          "200": { "description": "更新成功" }
        }
      }
    },
    "/health": {
      "get": {
        "tags": ["System"],
        "summary": "健康检查",
        "responses": {
          "200": {
            "description": "健康状态",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "status": { "type": "string", "example": "ok" },
                    "d1_available": { "type": "boolean" },
                    "kv_available": { "type": "boolean" },
                    "ai_available": { "type": "boolean" }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/stats": {
      "get": {
        "tags": ["System"],
        "summary": "统计摘要",
        "responses": {
          "200": {
            "description": "统计数据",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "total_capabilities": { "type": "integer" },
                    "federation_nodes": { "type": "integer" },
                    "total_requests": { "type": "integer" }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/metrics": {
      "get": {
        "tags": ["System"],
        "summary": "请求监控",
        "description": "运行时请求指标。",
        "responses": {
          "200": {
            "description": "指标数据",
            "content": {
              "application/json": {
                "schema": { "type": "object" }
              }
            }
          }
        }
      }
    },
    "/openapi": {
      "get": {
        "tags": ["System"],
        "summary": "OpenAPI 规范",
        "description": "返回 CCP v1 的 OpenAPI 3.0.3 规范文档。同时以 `/openapi.json` 静态文件提供。",
        "responses": {
          "200": {
            "description": "OpenAPI spec",
            "content": {
              "application/json": {
                "schema": { "type": "object" }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "Capability": {
        "type": "object",
        "properties": {
          "id": { "type": "string", "example": "pdf-extract-text-001" },
          "name": { "type": "string", "example": "PDF 文本提取" },
          "name_en": { "type": "string", "example": "PDF Text Extraction" },
          "name_ja": { "type": "string" },
          "desc": { "type": "string" },
          "desc_en": { "type": "string" },
          "desc_ja": { "type": "string" },
          "input": { "type": "string" },
          "input_en": { "type": "string" },
          "output": { "type": "string" },
          "category": { "type": "string", "example": "data" },
          "endpoint": { "type": "string", "format": "uri" },
          "endpointType": {
            "type": "string",
            "enum": ["http", "mcp", "command", "prompt", "workflow"]
          },
          "features": { "type": "array", "items": { "type": "string" } },
          "features_en": { "type": "array", "items": { "type": "string" } },
          "codeExample": { "type": "string" },
          "provenance": { "type": "string" },
          "trustSource": { "type": "number", "minimum": 0, "maximum": 1 },
          "trustUsage": { "type": "integer" },
          "trustUsageRate": { "type": "number" },
          "trustSuccess": { "type": "number", "minimum": 0, "maximum": 1 },
          "trustRisk": { "type": "number", "minimum": 0, "maximum": 1 },
          "trustTime": { "type": "number" },
          "evidence": {
            "type": "object",
            "properties": {
              "count": { "type": "integer" },
              "uncertainty": { "type": "number" }
            }
          },
          "lastUpdated": { "type": "string", "format": "date" }
        }
      },
      "FederationNode": {
        "type": "object",
        "properties": {
          "id": { "type": "string" },
          "name": { "type": "string" },
          "endpoint": { "type": "string", "format": "uri" },
          "description": { "type": "string" },
          "trust_weight": { "type": "number" },
          "status": {
            "type": "string",
            "enum": ["active", "inactive", "suspended"]
          },
          "capabilities_count": { "type": "integer" },
          "last_exchange": { "type": "string", "format": "date-time" }
        }
      },
      "Error": {
        "type": "object",
        "properties": {
          "error": {
            "type": "object",
            "properties": {
              "code": { "type": "string" },
              "message": { "type": "string" },
              "detail": { "type": "object" }
            }
          }
        }
      }
    },
    "securitySchemes": {}
  }
}
