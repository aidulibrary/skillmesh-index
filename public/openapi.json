{
  "openapi": "3.0.3",
  "info": {
    "title": "CCP 能力通约协议 API",
    "description": "CCP（Capability Commensurability Protocol）是面向 AI Agent 的能力发现与调用协议。提供能力锚点搜索、适配器生成、社区贡献、联邦治理等端点。",
    "version": "1.0.0",
    "contact": {
      "name": "SkillMesh",
      "url": "https://skillmesh.礼字号.中国"
    },
    "license": {
      "name": "CC BY-SA 4.0",
      "url": "https://creativecommons.org/licenses/by-sa/4.0/"
    }
  },
  "servers": [
    {
      "url": "https://skillmesh.礼字号.中国/api/ccp/v1",
      "description": "生产环境"
    }
  ],
  "tags": [
    { "name": "Capabilities", "description": "能力锚点发现与查询" },
    { "name": "Adapters", "description": "多框架适配器生成" },
    { "name": "Contribution", "description": "社区贡献端点" },
    { "name": "Telemetry", "description": "遥测回传" },
    { "name": "Federation", "description": "联邦网络管理" },
    { "name": "Governance", "description": "联邦治理（提案、投票）" },
    { "name": "Contributors", "description": "贡献者体系" },
    { "name": "Health", "description": "健康监控" }
  ],
  "paths": {
    "/capabilities": {
      "get": {
        "tags": ["Capabilities"],
        "summary": "获取所有能力锚点列表",
        "operationId": "listCapabilities",
        "responses": {
          "200": {
            "description": "能力锚点列表",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "protocol": { "type": "string", "example": "CCP" },
                    "version": { "type": "string", "example": "v1.0.0" },
                    "count": { "type": "integer", "example": 32 },
                    "capabilities": {
                      "type": "array",
                      "items": { "$ref": "#/components/schemas/Capability" }
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/capabilities/{id}": {
      "get": {
        "tags": ["Capabilities"],
        "summary": "获取单个能力锚点详情（含信任向量）",
        "operationId": "getCapability",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": { "type": "string" },
            "example": "pdf-extract-text-001"
          }
        ],
        "responses": {
          "200": {
            "description": "能力锚点详情",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/CapabilityDetail" }
              }
            }
          },
          "404": { "$ref": "#/components/responses/NotFound" }
        }
      }
    },
    "/capabilities/{id}/versions": {
      "get": {
        "tags": ["Capabilities"],
        "summary": "获取能力锚点版本历史",
        "operationId": "getCapabilityVersions",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": { "type": "string" }
          }
        ],
        "responses": {
          "200": {
            "description": "版本历史列表",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "capability_id": { "type": "string" },
                    "versions": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "version": { "type": "integer" },
                          "changes": { "type": "string" },
                          "created_at": { "type": "string" }
                        }
                      }
                    },
                    "count": { "type": "integer" }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/capabilities/{id}/adapters/{framework}": {
      "get": {
        "tags": ["Adapters"],
        "summary": "生成指定框架的适配器（含可运行示例）",
        "operationId": "getAdapter",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": { "type": "string" }
          },
          {
            "name": "framework",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "enum": ["dsh", "mcp", "langchain", "crewai", "dify"]
            }
          }
        ],
        "responses": {
          "200": {
            "description": "适配器内容（JSON/YAML）",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/Adapter" }
              },
              "application/x-yaml": {
                "schema": { "type": "string" }
              }
            }
          },
          "404": { "$ref": "#/components/responses/NotFound" }
        }
      }
    },
    "/search": {
      "get": {
        "tags": ["Capabilities"],
        "summary": "搜索能力锚点（FTS5 全文搜索 + 语义排序）",
        "operationId": "searchCapabilities",
        "parameters": [
          {
            "name": "q",
            "in": "query",
            "required": true,
            "schema": { "type": "string" },
            "example": "pdf"
          },
          {
            "name": "federated",
            "in": "query",
            "schema": { "type": "boolean", "default": false },
            "description": "是否启用联邦搜索"
          }
        ],
        "responses": {
          "200": {
            "description": "搜索结果",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "protocol": { "type": "string" },
                    "version": { "type": "string" },
                    "query": { "type": "string" },
                    "count": { "type": "integer" },
                    "federated": { "type": "boolean" },
                    "results": {
                      "type": "array",
                      "items": { "$ref": "#/components/schemas/Capability" }
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/contribute": {
      "post": {
        "tags": ["Contribution"],
        "summary": "贡献能力锚点",
        "operationId": "contributeCapability",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/ContributeRequest" }
            }
          }
        },
        "responses": {
          "201": {
            "description": "贡献成功，含下一步引导",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ContributeResponse" }
              }
            }
          },
          "409": { "description": "能力 ID 已存在" },
          "422": { "description": "Schema 校验失败" }
        }
      }
    },
    "/telemetry": {
      "post": {
        "tags": ["Telemetry"],
        "summary": "回传遥测数据（调用事件）",
        "operationId": "postTelemetry",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "capability_id": { "type": "string" },
                  "success": { "type": "boolean" },
                  "latency_ms": { "type": "number" },
                  "error": { "type": "string" },
                  "caller_node": { "type": "string" },
                  "trace_id": { "type": "string" }
                },
                "required": ["capability_id", "success"]
              }
            }
          }
        },
        "responses": {
          "201": { "description": "遥测已记录" }
        }
      }
    },
    "/federation": {
      "get": {
        "tags": ["Federation"],
        "summary": "获取本节点信息",
        "operationId": "getNodeInfo",
        "responses": {
          "200": {
            "description": "节点信息",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/NodeInfo" }
              }
            }
          }
        }
      }
    },
    "/federation/nodes": {
      "get": {
        "tags": ["Federation"],
        "summary": "获取联邦节点列表",
        "operationId": "listNodes",
        "responses": {
          "200": {
            "description": "节点列表",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "nodes": {
                      "type": "array",
                      "items": { "$ref": "#/components/schemas/NodeInfo" }
                    },
                    "count": { "type": "integer" }
                  }
                }
              }
            }
          }
        }
      },
      "post": {
        "tags": ["Federation"],
        "summary": "注册联邦节点",
        "operationId": "registerNode",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/NodeInfo" }
            }
          }
        },
        "responses": {
          "201": { "description": "节点注册成功" }
        }
      }
    },
    "/federation/nodes/{id}": {
      "delete": {
        "tags": ["Federation"],
        "summary": "移除联邦节点",
        "operationId": "removeNode",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": { "type": "string" }
          }
        ],
        "responses": {
          "200": { "description": "节点已移除" }
        }
      }
    },
    "/federation/nodes/{id}/trust-policy": {
      "get": {
        "tags": ["Federation"],
        "summary": "获取节点信任策略",
        "operationId": "getTrustPolicy",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": { "type": "string" }
          }
        ],
        "responses": {
          "200": { "description": "节点信任策略" }
        }
      },
      "put": {
        "tags": ["Federation"],
        "summary": "更新节点信任策略",
        "operationId": "updateTrustPolicy",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": { "type": "string" }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "weights": {
                    "type": "object",
                    "properties": {
                      "source": { "type": "number" },
                      "usage": { "type": "number" },
                      "success": { "type": "number" },
                      "risk": { "type": "number" },
                      "time": { "type": "number" }
                    }
                  },
                  "thresholds": {
                    "type": "object",
                    "properties": {
                      "min_trust": { "type": "number" },
                      "min_evidence": { "type": "integer" },
                      "max_uncertainty": { "type": "number" }
                    }
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": { "description": "策略已更新" }
        }
      }
    },
    "/federation/exchange": {
      "post": {
        "tags": ["Federation"],
        "summary": "联邦索引摘要交换",
        "operationId": "federationExchange",
        "responses": {
          "200": { "description": "交换完成" }
        }
      }
    },
    "/governance/proposals": {
      "get": {
        "tags": ["Governance"],
        "summary": "获取治理提案列表",
        "operationId": "listProposals",
        "responses": {
          "200": { "description": "提案列表" }
        }
      }
    },
    "/governance/proposals/{id}": {
      "get": {
        "tags": ["Governance"],
        "summary": "获取提案详情",
        "operationId": "getProposal",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": { "type": "string" }
          }
        ],
        "responses": {
          "200": { "description": "提案详情" }
        }
      },
      "patch": {
        "tags": ["Governance"],
        "summary": "更新提案状态",
        "operationId": "updateProposal",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": { "type": "string" }
          }
        ],
        "responses": {
          "200": { "description": "提案状态已更新" }
        }
      }
    },
    "/governance/proposals/{id}/vote": {
      "post": {
        "tags": ["Governance"],
        "summary": "对提案投票",
        "operationId": "voteOnProposal",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": { "type": "string" }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "vote": {
                    "type": "string",
                    "enum": ["approve", "reject", "abstain"]
                  },
                  "node_id": { "type": "string" },
                  "trust_score": { "type": "number" }
                },
                "required": ["vote", "node_id"]
              }
            }
          }
        },
        "responses": {
          "201": { "description": "投票成功" }
        }
      }
    },
    "/contributors": {
      "get": {
        "tags": ["Contributors"],
        "summary": "获取贡献者列表（含排行榜）",
        "operationId": "listContributors",
        "parameters": [
          {
            "name": "sort",
            "in": "query",
            "schema": {
              "type": "string",
              "enum": ["contributions", "trust_score", "recent"],
              "default": "contributions"
            }
          },
          {
            "name": "limit",
            "in": "query",
            "schema": { "type": "integer", "default": 20 }
          }
        ],
        "responses": {
          "200": { "description": "贡献者列表" }
        }
      }
    },
    "/contributors/leaderboard": {
      "get": {
        "tags": ["Contributors"],
        "summary": "贡献者排行榜（含排名位置）",
        "operationId": "getLeaderboard",
        "parameters": [
          {
            "name": "sort",
            "in": "query",
            "schema": {
              "type": "string",
              "enum": ["contributions_count", "trust_score", "last_seen"],
              "default": "contributions_count"
            }
          },
          {
            "name": "limit",
            "in": "query",
            "schema": { "type": "integer", "default": 20, "maximum": 100 }
          }
        ],
        "responses": {
          "200": {
            "description": "排行榜",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "sort": { "type": "string" },
                    "count": { "type": "integer" },
                    "leaderboard": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "rank": { "type": "integer" },
                          "github_login": { "type": "string" },
                          "role": { "type": "string" },
                          "contributions_count": { "type": "integer" },
                          "trust_score": { "type": "number" },
                          "badges": { "type": "array" }
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/contributors/{id}": {
      "get": {
        "tags": ["Contributors"],
        "summary": "获取贡献者详情",
        "operationId": "getContributor",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": { "type": "string" }
          }
        ],
        "responses": {
          "200": { "description": "贡献者详情" }
        }
      }
    },
    "/health": {
      "get": {
        "tags": ["Health"],
        "summary": "获取联邦网络健康状态",
        "operationId": "getHealth",
        "responses": {
          "200": {
            "description": "健康状态",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/HealthStatus" }
              }
            }
          }
        }
      }
    },
    "/metrics": {
      "get": {
        "tags": ["Health"],
        "summary": "获取请求监控指标",
        "operationId": "getMetrics",
        "responses": {
          "200": { "description": "监控指标" }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "Capability": {
        "type": "object",
        "properties": {
          "id": { "type": "string", "example": "pdf-extract-text-001" },
          "name": { "type": "string", "example": "PDF 文本提取" },
          "name_en": { "type": "string", "example": "PDF Text Extraction" },
          "desc": { "type": "string" },
          "category": { "type": "string", "example": "document" },
          "endpoint": { "type": "string", "example": "https://..." },
          "endpointType": {
            "type": "string",
            "enum": ["http", "mcp", "function"]
          },
          "trustSource": { "type": "number", "minimum": 0, "maximum": 1 },
          "trustUsage": { "type": "number" },
          "trustSuccess": { "type": "number", "minimum": 0, "maximum": 1 },
          "trustRisk": { "type": "number", "minimum": 0, "maximum": 1 },
          "trustTime": { "type": "number", "minimum": 0, "maximum": 1 },
          "version": { "type": "integer" }
        }
      },
      "CapabilityDetail": {
        "allOf": [
          { "$ref": "#/components/schemas/Capability" },
          {
            "type": "object",
            "properties": {
              "versions": { "type": "array" },
              "version_count": { "type": "integer" },
              "trust_radar": { "$ref": "#/components/schemas/TrustRadar" }
            }
          }
        ]
      },
      "TrustRadar": {
        "type": "object",
        "description": "信任雷达图数据（五维度）",
        "properties": {
          "dimensions": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "name": { "type": "string", "example": "来源可信度" },
                "name_en": { "type": "string", "example": "Source Trust" },
                "value": { "type": "number", "minimum": 0, "maximum": 1 },
                "weight": { "type": "number" }
              }
            }
          },
          "overall": { "type": "number", "description": "综合信任分" },
          "evidence_count": { "type": "integer" },
          "uncertainty": { "type": "number" }
        }
      },
      "Adapter": {
        "type": "object",
        "properties": {
          "adapter": { "type": "object" },
          "examples": {
            "type": "object",
            "properties": {
              "curl": { "type": "string" },
              "python": { "type": "string" },
              "javascript": { "type": "string" }
            }
          }
        }
      },
      "ContributeRequest": {
        "type": "object",
        "required": [
          "id",
          "name",
          "name_en",
          "desc",
          "desc_en",
          "endpoint",
          "endpointType",
          "category"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9]+(-[a-z0-9]+)*-[0-9]{3}$"
          },
          "name": { "type": "string" },
          "name_en": { "type": "string" },
          "desc": { "type": "string", "maxLength": 500 },
          "desc_en": { "type": "string", "maxLength": 500 },
          "input": { "type": "string" },
          "output": { "type": "string" },
          "endpoint": { "type": "string" },
          "endpointType": {
            "type": "string",
            "enum": ["http", "mcp", "function"]
          },
          "category": { "type": "string" },
          "features": { "type": "array", "items": { "type": "string" } },
          "provenance": { "type": "string" },
          "trustSource": { "type": "number", "minimum": 0, "maximum": 1 },
          "trustRisk": { "type": "number", "minimum": 0, "maximum": 1 }
        }
      },
      "ContributeResponse": {
        "type": "object",
        "properties": {
          "protocol": { "type": "string" },
          "version": { "type": "string" },
          "accepted": { "type": "boolean" },
          "capability_id": { "type": "string" },
          "message": { "type": "string" },
          "next_steps": {
            "type": "object",
            "properties": {
              "search": { "type": "string" },
              "adapter": { "type": "string" },
              "telemetry": { "type": "string" },
              "trust_tracking": { "type": "string" }
            }
          }
        }
      },
      "NodeInfo": {
        "type": "object",
        "properties": {
          "node_id": { "type": "string" },
          "node_name": { "type": "string" },
          "node_url": { "type": "string" },
          "status": {
            "type": "string",
            "enum": ["healthy", "degraded", "stale", "offline"]
          },
          "trust_score": { "type": "number" },
          "capability_count": { "type": "integer" },
          "last_exchange": { "type": "string" }
        }
      },
      "HealthStatus": {
        "type": "object",
        "properties": {
          "status": { "type": "string", "enum": ["healthy", "degraded"] },
          "nodes": {
            "type": "object",
            "properties": {
              "total": { "type": "integer" },
              "healthy": { "type": "integer" },
              "degraded": { "type": "integer" },
              "stale": { "type": "integer" },
              "offline": { "type": "integer" }
            }
          },
          "coverage": { "type": "number", "description": "索引覆盖率" },
          "last_24h": {
            "type": "object",
            "properties": {
              "total_calls": { "type": "integer" },
              "by_type": { "type": "object" }
            }
          }
        }
      }
    },
    "responses": {
      "NotFound": {
        "description": "资源未找到",
        "content": {
          "application/json": {
            "schema": {
              "type": "object",
              "properties": {
                "error": { "type": "string" },
                "type": { "type": "string" },
                "detail": { "type": "object" }
              }
            }
          }
        }
      }
    }
  }
}
